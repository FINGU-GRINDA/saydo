rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Meetings - users can only access their own meetings
    match /meetings/{meetingId} {
      allow read, write: if request.auth != null && 
        (resource == null || resource.data.user_id == request.auth.uid);
      
      // Allow creation if user_id matches authenticated user
      allow create: if request.auth != null && 
        request.resource.data.user_id == request.auth.uid;
    }
    
    // Actions - users can only access actions for their meetings
    match /actions/{actionId} {
      allow read, write: if request.auth != null && 
        (resource == null || resource.data.user_id == request.auth.uid);
      
      // Allow creation if user_id matches authenticated user  
      allow create: if request.auth != null && 
        request.resource.data.user_id == request.auth.uid;
    }
    
    // Agent preferences - users can only access their own preferences
    match /agent_preferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Real-time subscriptions for meetings and actions
    match /meetings/{meetingId} {
      allow read: if request.auth != null && 
        resource.data.user_id == request.auth.uid;
        
      match /actions/{actionId} {
        allow read: if request.auth != null && 
          get(/databases/$(database)/documents/meetings/$(meetingId)).data.user_id == request.auth.uid;
      }
    }
  }
} 